<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">

    <!-- LibStub must load first – it is the library versioning system -->
    <Script file="LibStub\LibStub.lua"/>

    <!-- CallbackHandler is required by most Ace3 libraries -->
    <Include file="CallbackHandler-1.0\CallbackHandler-1.0.xml"/>

    <!-- Ace3 core libraries -->
    <Include file="AceAddon-3.0\AceAddon-3.0.xml"/>
    <Include file="AceDB-3.0\AceDB-3.0.xml"/>
    <Include file="AceEvent-3.0\AceEvent-3.0.xml"/>
    <Include file="AceConsole-3.0\AceConsole-3.0.xml"/>

    <!-- Data Broker for minimap integration -->
    <Script file="LibDataBroker-1.1\LibDataBroker-1.1.lua"/>

    <!-- Optional libraries (added by .pkgmeta during CurseForge packaging):
         - LibSharedMedia-3.0\lib.xml   (bar textures and fonts)
         - LibDBIcon-1.0\lib.xml        (minimap button)
         To use locally, run fetch_libs.sh or download from CurseForge. -->

</Ui>
